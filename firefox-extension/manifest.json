{
  "manifest_version": 3,
  "name": "Board Snapshot Assistant",
  "version": "0.1.0",
  "description": "Read-only Board inventory and selected-scope reports for an AI-assisted review.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "Analyze Board",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "board-snapshot-assistant@biosmanagement.it",
      "strict_min_version": "115.0"
    }
  }
}
